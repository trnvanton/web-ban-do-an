# ===== CẤU HÌNH SERVER =====
PORT=3000

# ===== CƠ SỞ DỮ LIỆU =====
# Chọn driver:
#   sqlite -> chạy test local không cần cài MySQL (tự seed dữ liệu demo)
#   mysql  -> dùng khi deploy (cần tạo DB web_ban_do_an trên MySQL)
DB_DRIVER=sqlite
DB_FILE=app.db

# Chỉ dùng khi DB_DRIVER=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=web_ban_do_an

# ===== BẢO MẬT =====
# Khóa bí mật ký JWT - BẮT BUỘC phải đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_SECRET=doi-me-khoa-bay-mat-o-day-toi-thieu-32-ky-tu
# Thời gian sống của token (mặc định 7 ngày)
JWT_EXPIRES_IN=7d
